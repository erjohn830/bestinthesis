  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogTypewriter
  dialogText: {fileID: 1922362523}
  nextButton: {fileID: 1922362521}
  playButton: {fileID: 1898252183}
  sentences:
  - 'Jorge: "Pre, miss ka na namin sa labas. Hindi ka na namin nakakalaro."  '
  - "Henry: \"Mas okay na \u2019to eh\u2026 hindi ako natatalo, hindi ako napapagod.\"  "
  - "Jorge: \"Oo, pero\u2026 hindi ka rin masyadong tumatawa.\" "
  - 'Henry: "...Natalo pa."  '
  - "Henry: \"Ang saya naman nila\u2026\" "
  - 'Jorge: "Halika na. Isang laro lang. Pag hindi ka nasiyahan, pwede ka bumalik
    sa cellphone mo." '
  - 'Henry: "Sige. Try ko lang."  '
  typingSpeed: 0.05
  sceneToLoad: Patinterohistory
